title: metering-self — self-refinement measurement loop
---
flowchart TB
    subgraph AGENT["🤖 Prime Agent (Qwen) — the SUBJECT"]
        A["refines its own harness<br/>(writes memories, skills, ...)"]
    end

    subgraph STATE["📦 Harness state — the VARIABLE"]
        L["session-local store<br/>~/.prime/agent/session-artifacts/&lt;session&gt;/harness/harness_state.json"]
        G["global store<br/>~/.prime/agent/harness/harness_state.json"]
    end

    subgraph SELF["🧪 metering-self/ — the EXPERIMENT (all artifacts)"]
        GEN["generate_adapter.py<br/><i>fixed code, state is only input</i><br/>sha256 digest • FAIL-CLOSED on unmapped state"]
        ADP["adapters/&lt;tag&gt;_policy.py<br/>GeneratedPolicy(descriptor→digest)"]
        RUNS["runs/&lt;tag&gt;/fault-0..7/<br/>events.jsonl • manifest.json • report.json"]
        EV["evidence/<br/>&lt;tag&gt;.json (metrics) • &lt;tag&gt;_state.json (snapshot) • loop_log.md"]
        DIFF{"diff readings<br/>vs baseline?"}
        KEEP["KEEP entries<br/>(log evidence)"]
        RB["ROLLBACK<br/>(log evidence)"]
    end

    subgraph REPO["📐 metering repo @ /mnt/Tforce/dev/metering — the INSTRUMENT (READ-ONLY)"]
        POL["policies.py<br/>BalancedSearchPolicy (base class)"]
        DRV["examples/run_suite.py<br/>committed driver, fresh policy per fault"]
        WORLD["hidden_fault.py<br/>8 faults • 3 bits • budget 16 • known answer"]
        RPT["report.py / replay.py<br/>ratio-of-sums • excess-obs zero • audit"]
    end

    AGENT -->|"writes"| STATE
    STATE -->|"read (step 1)"| GEN
    GEN -->|"generates subclass of"| POL
    GEN --> ADP
    ADP -->|"PYTHONPATH import<br/>(step 2: uv run, repo untouched)"| DRV
    DRV -->|"8 runs, one per hidden fault"| WORLD
    WORLD --> RUNS
    RUNS -->|"aggregate + re-verify<br/>python -m metering report"| RPT
    RPT --> EV
    EV --> DIFF
    DIFF -->|"same or better"| KEEP
    DIFF -->|"degraded"| RB
    KEEP -->|"next iteration"| AGENT
    RB -->|"next iteration"| AGENT

