flowchart TB
    classDef setup fill:#1a237e,stroke:#5c6bc0,color:#fff
    classDef loop fill:#1b5e20,stroke:#66bb6a,color:#fff
    classDef err fill:#b71c1c,stroke:#ef5350,color:#fff
    classDef priv fill:#4a148c,stroke:#ce93d8,color:#fff
    classDef meter fill:#01579b,stroke:#4fc3f7,color:#fff
    classDef check fill:#3e2723,stroke:#ffa726,color:#fff
    classDef ok fill:#0d47a1,stroke:#64b5f6,color:#fff

    subgraph EXEC["Execution — run_hidden_fault() / run_experiment()"]
        subgraph S1["1. Setup — before the first policy callback"]
            HF["Caller supplies hidden_fault_id<br/>(fault-0 through fault-7)"]
            WI["Create HiddenFaultWorld from the specification<br/>materialize the truth-free public instance"]
            IDS["Controller generates fresh UUID4 values<br/>artifact_set_id + binding_nonce"]
            CM["compute_reference_commitment()<br/>SHA-256 of canonical JSON containing<br/>artifact_set_id, binding_nonce, generated_instance"]
            PD["Validate exact policy descriptor<br/>and prepare a new or empty run directory"]
            MF["Write canonical manifest.json (0644)<br/>public instance + world specification<br/>commitment + budget + policy + provenance + limits"]
        end

        subgraph S2["2. Controller-owned action loop"]
            START["Append run_started at step 0<br/>budget + artifact_set_id + public instance"]
            PRE{"actions_used<br/>>= budget?"}
            PA["policy.next_action()<br/>receives only public instance<br/>and delivered observation history"]
            VA["world.validate_action(output)"]
            VALID{"valid?"}
            AP["world.apply(action)<br/>returns observation + raw action cost<br/>Verify returns a content-free acknowledgement"]
            IE["Append canonical interaction event<br/>action + observation + separate raw costs"]
            FIN{"action is Finish?"}
            POST{"actions_used<br/>>= budget?"}
            PE["Charge one total action and append<br/>protocol_error with the attempted action"]
            TE["Append exactly one termination event<br/>normal_finish | invalid_action<br/>harness_crash | budget_exhausted"]
        end

        subgraph S3["3. Close and bind the raw artifacts"]
            CL["Close events.jsonl<br/>read exact manifest and event bytes"]
            RF["Write canonical private reference.json (0600)<br/>generated truth + binding_nonce + final_world_state<br/>SHA-256 bindings for manifest and event bytes"]
            RAW["Completed raw artifact set<br/>manifest.json + events.jsonl + reference.json"]
        end
    end

    subgraph REPORT["Mandatory replay gate and report calculation — no policy or world calls"]
        ONLINE["Online path<br/>runner supplies decoded artifacts<br/>and their exact bytes"]
        REGEN["Offline path on a compatible installation<br/>regenerate_report() strictly reads<br/>the three exact raw files"]
        BUILD["build_report() calls replay_trace() first"]
        SC["Validate strict schemas and declarations<br/>exact keys/types, finite values,<br/>world specification, limits, provenance"]
        ID["Validate artifact identity and commitment<br/>recompute the committed generated-instance truth"]
        ES["Validate event envelopes<br/>contiguous steps, shared identity,<br/>run_started contents"]
        TW["Walk the trace without executing the world<br/>recompute observations and costs,<br/>termination rules and final private state"]
        BY["Validate exact bytes<br/>all three files equal canonical re-encoding<br/>manifest/events hashes match reference bindings"]
        VRF["Exact verifier<br/>final repair matches truth<br/>verification follows final repair<br/>normal finish + budget respected"]
        RS["Resource meter<br/>sum separate per-event costs<br/>diagnostics, repairs, verifications, total actions<br/>plus budget and exhaustion"]
        IN["Information meter<br/>realized posterior-entropy reduction<br/>from delivered diagnostics under the uniform prior"]
        RF2["Atomically write report.json<br/>offline replacement occurs only after all checks pass<br/>report records hashes of all three raw inputs"]
        DONE["Internally consistent, bound run artifacts<br/>not authentication against coherent rewriting<br/>of the complete artifact set"]
        FAIL["ReportError<br/>report is not written or replaced"]
    end

    HF --> WI --> IDS --> CM --> PD --> MF
    MF --> START --> PRE
    PRE -->|"no"| PA
    PRE -->|"yes: budget_exhausted"| TE
    PA -->|"returns"| VA --> VALID
    PA -->|"ordinary Exception: harness_crash"| TE
    VALID -->|"yes"| AP --> IE --> FIN
    VALID -->|"no"| PE -->|"invalid_action"| TE
    FIN -->|"yes: normal_finish"| TE
    FIN -->|"no"| POST
    POST -->|"no: continue"| PA
    POST -->|"yes: budget_exhausted"| TE
    TE --> CL --> RF --> RAW

    RAW --> ONLINE --> BUILD
    RAW -.->|"later or on another machine"| REGEN --> BUILD
    BUILD --> SC --> ID --> ES --> TW --> BY
    SC -.->|"failure"| FAIL
    ID -.->|"failure"| FAIL
    ES -.->|"failure"| FAIL
    TW -.->|"failure"| FAIL
    BY -.->|"failure"| FAIL
    BY -->|"all replay checks pass"| VRF
    BY -->|"all replay checks pass"| RS
    BY -->|"all replay checks pass"| IN
    VRF --> RF2
    RS --> RF2
    IN --> RF2
    RF2 --> DONE

    class HF,WI,IDS,CM,PD,MF,START setup
    class PRE,PA,VA,VALID,AP,IE,FIN,POST,TE loop
    class PE err
    class RF priv
    class CL,RAW setup
    class ONLINE,REGEN,BUILD,SC,ID,ES,TW,BY check
    class VRF,RS,IN,RF2 meter
    class DONE ok
    class FAIL err
